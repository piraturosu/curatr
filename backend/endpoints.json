{
  "GET /api": {
    "description": "serves up a json representation of all the available endpoints of the api"
  },
  "POST /api/auth/register": {
    "description": "Registers a new user account.",
    "input fields": ["username", "password"],
    "exampleRequest": {
      "username": "george",
      "password": "mypassword123"
    },
    "exampleResponse": {
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "user": {
        "user_id": 1,
        "username": "george"
      }
    },
    "errors": {
      "400": "Missing username or password",
      "409": "Username already exists"
    }
  },
  "POST /api/auth/login": {
    "description": "Authenticates a user and returns a JWT token.",
    "input fields": ["username", "password"],
    "exampleRequest": {
      "username": "george",
      "password": "mypassword123"
    },
    "exampleResponse": {
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "user": {
        "user_id": 1,
        "username": "george"
      }
    },
    "errors": {
      "400": "Missing username or password",
      "401": "Invalid credentials"
    }
  },
  "GET /api/exhibitions/temp": {
    "description": "Returns all temporary exhibition artworks saved by the logged-in user.",
    "authentication": "Bearer Token Required",
    "exampleResponse": {
      "temp_exhibitions": [
        {
          "temp_id": 3,
          "user_id": 1,
          "artwork": {
            "id": "pex-1001",
            "title": "Sample Artwork",
            "artist": "Test Artist",
            "year": "2000",
            "image": "https://images.pexels.com/photos/1001682/pexels-photo-1001682.jpeg"
          },
          "created_at": "2025-03-11T12:16:57.436Z"
        }
      ]
    }
  },
  "POST /api/exhibitions/temp": {
    "description": "Saves a single artwork object to the user's temporary exhibition collection.",
    "authentication": "Bearer Token Required",
    "input fields": ["artwork (object)"],
    "exampleRequest": {
      "artwork": {
        "id": "pex-9999",
        "title": "New Artwork",
        "artist": "Test Artist",
        "year": "2024",
        "image": "https://example.com/art.jpg"
      }
    },
    "exampleResponse": {
      "temp_exhibition": {
        "temp_id": 5,
        "user_id": 1,
        "artwork": {
          "id": "pex-9999",
          "title": "New Artwork",
          "artist": "Test Artist",
          "year": "2024",
          "image": "https://example.com/art.jpg"
        },
        "created_at": "2025-03-11T12:17:57.436Z"
      }
    },
    "errors": {
      "400": "Artwork data is required",
      "401": "Missing or invalid token"
    }
  },
  "DELETE /api/exhibitions/temp/:temp_id": {
    "description": "Deletes a specific artwork from the user's temporary exhibition collection.",
    "authentication": "Bearer Token Required",
    "exampleRequest": {
      "temp_id": 3
    },
    "exampleResponse": {
      "status": 204,
      "msg": "No content"
    },
    "errors": {
      "404": "Item not found",
      "401": "Missing or invalid token"
    }
  }
}
